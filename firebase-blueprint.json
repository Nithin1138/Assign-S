{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "User's profile photo URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of account creation." }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Document": {
      "title": "Assignment Document",
      "description": "An AI-generated or user-edited assignment document.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner." },
        "title": { "type": "string", "description": "Title of the assignment." },
        "content": { "type": "string", "description": "HTML content of the assignment." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last update." }
      },
      "required": ["userId", "title", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/users/{userId}/assignments/{assignmentId}": {
      "schema": "Document",
      "description": "Assignment documents owned by users in their subcollection."
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": "Document",
      "description": "Custom templates saved by users."
    }
  }
}
