      "html": "\n<div class=\"relative w-full min-h-[900px] bg-[#FBFBFA] flex items-center font-sans text-[#1A120B] py-24\" data-kid=\"0\">\n  \n  <div class=\"absolute inset-0 pointer-events-none opacity-[0.05] mix-blend-multiply\" style=\"background-image: url('https://www.transparenttextures.com/patterns/natural-paper.png');\" data-kid=\"1\">\n  </div>\n\n  \n  <div class=\"absolute -top-[10%] -right-[5%] w-[600px] h-[600px] bg-violet-200/20 blur-[120px] rounded-full\" data-kid=\"2\"></div>\n  <div class=\"absolute -bottom-[10%] -left-[5%] w-[500px] h-[500px] bg-cyan-100/30 blur-[100px] rounded-full\" data-kid=\"3\"></div>\n\n  <div class=\"max-w-[1440px] mx-auto w-[90%] grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-12 xl:gap-24 items-center relative z-10\" data-kid=\"4\">\n    \n    \n    <div class=\"relative pr-8\" data-kid=\"5\">\n      <div class=\"inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white border border-[#E7E5E4] shadow-sm mb-8\" data-kid=\"6\">\n        <span class=\"relative flex h-2 w-2\" data-kid=\"7\">\n          <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75\" data-kid=\"8\"></span>\n          <span class=\"relative inline-flex rounded-full h-2 w-2 bg-violet-500\" data-kid=\"9\"></span>\n        </span>\n        <span class=\"text-[11px] font-bold uppercase tracking-[0.2em] text-[#1A120B]/60\" data-kid=\"10\">Academic Intelligence v4.0</span>\n      </div>\n      \n      <h1 class=\"text-6xl xl:text-7xl font-black leading-[0.95] tracking-tight mb-8\" data-kid=\"11\">\n        Precision<br data-kid=\"12\">\n        <span class=\"italic font-serif font-medium text-violet-600\" data-kid=\"13\">Research</span><br data-kid=\"14\">\n        Synthesized.\n      </h1>\n      \n      <p class=\"text-xl text-[#1A120B]/70 max-w-lg mb-12 leading-relaxed font-medium\" data-kid=\"15\">\n        Transform fragmented notes and complex datasets into peer-reviewed quality manuscripts. Doxio understands the nuance of academic rigor.\n      </p>\n\n      <div class=\"flex flex-col sm:flex-row items-center gap-6\" data-kid=\"16\">\n        <button class=\"btn-aurora group relative px-10 py-5 text-white rounded-2xl font-bold text-lg shadow-2xl transition-all hover:scale-[1.02] hover:-translate-y-0.5 active:scale-[0.98] flex items-center gap-3\" data-kid=\"17\">\n          <span data-kid=\"18\">Begin New Project</span>\n          <i class=\"ti ti-arrow-right text-xl group-hover:translate-x-1 transition-transform\" data-kid=\"19\"></i>\n        </button>\n        <button class=\"px-10 py-5 bg-white border border-[#E7E5E4] text-[#1A120B] rounded-2xl font-bold text-lg hover:bg-stone-50 transition-all shadow-sm\" data-kid=\"20\">\n          Watch Methodology\n        </button>\n      </div>\n\n      \n      <div class=\"mt-14 flex flex-col gap-4 opacity-40 hover:opacity-100 transition-all duration-700\" data-kid=\"21\">\n        <span class=\"text-[10px] font-bold uppercase tracking-[0.4em] text-[#1A120B]/70\" data-kid=\"22\">Trusted at leading institutions</span>\n        <div class=\"flex gap-10 items-center\" data-kid=\"23\">\n          <span class=\"font-serif italic font-bold text-2xl tracking-tight text-[#1A120B]/80 hover:text-[#1A120B] transition-colors cursor-default\" data-kid=\"24\">Stanford</span>\n          <span class=\"font-serif italic font-bold text-2xl tracking-tight text-[#1A120B]/80 hover:text-[#1A120B] transition-colors cursor-default\" data-kid=\"25\">Oxford</span>\n          <span class=\"font-serif italic font-bold text-2xl tracking-tight text-[#1A120B]/80 hover:text-[#1A120B] transition-colors cursor-default\" data-kid=\"26\">Cambridge</span>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute -top-12 -right-4 rotate-[8deg] hidden xl:block\" data-kid=\"27\">\n        <div class=\"flex flex-col items-start gap-0\" data-kid=\"28\">\n          <span class=\"font-handwriting text-4xl text-violet-700 leading-none drop-shadow-sm\" data-kid=\"29\">Elevate your<br data-kid=\"30\">thesis.</span>\n          <i class=\"ti ti-arrow-back-up text-violet-400 text-4xl -rotate-90 ml-6 -mt-1\" data-kid=\"31\"></i>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative h-[720px] flex items-center justify-center perspective-[1000px] ml-12\" data-kid=\"32\">\n      \n      \n      <div class=\"absolute w-[480px] xl:w-[520px] aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl rotate-[-12deg] -translate-x-12 -translate-y-24 blur-[0.3px] opacity-90 border-[12px] border-white floating-1 transition-transform duration-700 hover:rotate-[-10deg] hover:scale-105 group cursor-pointer\" data-kid=\"33\">\n        <img src=\"https://images.unsplash.com/photo-1776618917402-4721be61dce0?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-95 transition-all duration-700 group-hover:grayscale-0 group-hover:brightness-100\" alt=\"Open Library Book\" decoding=\"async\" loading=\"lazy\" data-kid=\"34\">\n        <div class=\"absolute inset-0 bg-stone-900/10 mix-blend-overlay\" data-kid=\"35\"></div>\n      </div>\n\n      \n      <div class=\"absolute z-10 w-[400px] xl:w-[440px] p-10 rounded-3xl glass-card rotate-[6deg] translate-x-16 -translate-y-16 shadow-2xl border border-white/50 floating-2 hover:rotate-[4deg] transition-transform duration-700 cursor-default\" data-kid=\"36\">\n        <div class=\"flex items-center gap-3 mb-6 pb-4 border-b border-stone-200/30\" data-kid=\"37\">\n          <div class=\"flex gap-1.5\" data-kid=\"38\">\n            <div class=\"w-2.5 h-2.5 rounded-full bg-red-400/40\" data-kid=\"39\"></div>\n            <div class=\"w-2.5 h-2.5 rounded-full bg-amber-400/40\" data-kid=\"40\"></div>\n            <div class=\"w-2.5 h-2.5 rounded-full bg-emerald-400/40\" data-kid=\"41\"></div>\n          </div>\n          <span class=\"ml-auto text-[10px] font-mono text-stone-400 font-bold uppercase tracking-[0.2em]\" data-kid=\"42\">APA 7th Edition</span>\n        </div>\n        <div class=\"space-y-4\" data-kid=\"43\">\n          <div class=\"h-2.5 w-full bg-stone-900/5 rounded-full\" data-kid=\"44\"></div>\n          <div class=\"h-2.5 w-11/12 bg-stone-900/5 rounded-full\" data-kid=\"45\"></div>\n          <div class=\"h-2.5 w-9/12 bg-stone-900/5 rounded-full\" data-kid=\"46\"></div>\n          <div class=\"pt-6\" data-kid=\"47\">\n            <p class=\"text-[13px] font-serif leading-relaxed text-stone-800 italic relative z-10\" data-kid=\"48\">\n              <span class=\"text-violet-500 font-bold mr-1\" data-kid=\"49\">“</span>\n              ...the synthesis of autonomous research agents allows for a 40% reduction in bibliographic latency while maintaining structural integrity in citation mapping.\n              <span class=\"text-violet-500 font-bold ml-1\" data-kid=\"50\">”</span>\n            </p>\n            <p class=\"text-[11px] font-bold text-violet-600 mt-4 tracking-wide\" data-kid=\"51\">— Thompson & Weaver, 2026</p>\n          </div>\n        </div>\n        \n        \n        <div class=\"absolute -top-12 -right-16 rotate-[8deg]\" data-kid=\"52\">\n          <div class=\"flex flex-col items-center\" data-kid=\"53\">\n             <span class=\"font-handwriting text-3xl text-cyan-600 drop-shadow-sm\" data-kid=\"54\">Auto-formatted!</span>\n             <i class=\"ti ti-arrow-curve-left text-cyan-400 text-3xl -scale-y-100 rotate-45\" data-kid=\"55\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute z-20 w-[440px] xl:w-[460px] bg-white rounded-[40px] shadow-[0_40px_100px_-20px_rgba(0,0,0,0.2)] p-8 translate-x-20 translate-y-36 border border-stone-100 floating-3 hover:translate-y-32 transition-transform duration-700\" data-kid=\"56\">\n        <div class=\"flex items-center justify-between mb-8 pb-4 border-b border-stone-100\" data-kid=\"57\">\n          <div class=\"flex items-center gap-4\" data-kid=\"58\">\n             <div class=\"w-12 h-12 rounded-2xl bg-[#1A120B] flex items-center justify-center text-white shadow-lg\" data-kid=\"59\">\n                <i class=\"ti ti-sparkles text-2xl\" data-kid=\"60\"></i>\n             </div>\n             <div data-kid=\"61\">\n                <h4 class=\"text-base font-bold text-[#1A120B]\" data-kid=\"62\">Doxio Assistant</h4>\n                <div class=\"flex items-center gap-2\" data-kid=\"63\">\n                   <div class=\"w-2 h-2 rounded-full bg-emerald-500\" data-kid=\"64\"></div>\n                   <span class=\"text-[11px] font-bold text-stone-400 uppercase tracking-widest\" data-kid=\"65\">Generating Insight</span>\n                </div>\n             </div>\n          </div>\n          <div class=\"flex gap-2\" data-kid=\"66\">\n            <button class=\"w-10 h-10 rounded-full hover:bg-stone-50 transition-colors flex items-center justify-center text-stone-300\" data-kid=\"67\">\n               <i class=\"ti ti-maximize text-xl\" data-kid=\"68\"></i>\n            </button>\n            <button class=\"w-10 h-10 rounded-full hover:bg-stone-50 transition-colors flex items-center justify-center text-stone-300\" data-kid=\"69\">\n               <i class=\"ti ti-dots-vertical text-xl\" data-kid=\"70\"></i>\n            </button>\n          </div>\n        </div>\n        \n        <div class=\"space-y-6\" data-kid=\"71\">\n          <div class=\"flex flex-col items-end\" data-kid=\"72\">\n            <div class=\"bg-stone-50 rounded-2xl rounded-tr-none p-5 text-sm text-[#1A120B]/80 leading-relaxed border border-stone-100 max-w-[90%]\" data-kid=\"73\">\n               Help me synthesize the relationship between semantic AI and peer-review rigor.\n            </div>\n          </div>\n          \n          <div class=\"flex items-start gap-4\" data-kid=\"74\">\n            <div class=\"w-8 h-8 rounded-lg bg-violet-100 flex items-center justify-center text-violet-600 shrink-0\" data-kid=\"75\">\n               <i class=\"ti ti-cpu\" data-kid=\"76\"></i>\n            </div>\n            <div class=\"bg-violet-50/40 rounded-3xl rounded-tl-none p-6 text-sm text-stone-800 leading-relaxed border border-violet-100/50 relative overflow-hidden group\" data-kid=\"77\">\n               <div class=\"absolute top-0 left-0 w-1 h-full bg-violet-400/30\" data-kid=\"78\"></div>\n               <p class=\"relative z-10\" data-kid=\"79\">\n                 <span class=\"text-violet-600 font-bold block mb-2\" data-kid=\"80\">Analyzing Methodology...</span>\n                 Semantic AI acts as a secondary verification layer, cross-referencing claims against established peer-reviewed datasets to ensure epistemological consistency.\n               </p>\n               <div class=\"mt-4 pt-4 border-t border-violet-100/30 flex items-center gap-4\" data-kid=\"81\">\n                  <div class=\"flex items-center gap-1.5 px-3 py-1 bg-white rounded-full border border-violet-200 shadow-sm cursor-pointer hover:bg-violet-50 transition-all\" data-kid=\"82\">\n                     <i class=\"ti ti-plus text-xs text-violet-500\" data-kid=\"83\"></i>\n                     <span class=\"text-[10px] font-bold text-violet-600\" data-kid=\"84\">Insert Citation</span>\n                  </div>\n                  <div class=\"flex items-center gap-1.5 px-3 py-1 bg-white rounded-full border border-violet-200 shadow-sm cursor-pointer hover:bg-violet-50 transition-all\" data-kid=\"85\">\n                     <i class=\"ti ti-adjustments-horizontal text-xs text-violet-500\" data-kid=\"86\"></i>\n                     <span class=\"text-[10px] font-bold text-violet-600\" data-kid=\"87\">Refine Tone</span>\n                  </div>\n               </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"mt-10 flex items-center gap-3\" data-kid=\"88\">\n           <div class=\"flex-1 h-14 bg-stone-50 rounded-2xl border border-stone-100 flex items-center px-6 group focus-within:border-violet-300 transition-all\" data-kid=\"89\">\n              <i class=\"ti ti-microphone text-stone-300 mr-4 group-focus-within:text-violet-400\" data-kid=\"90\"></i>\n              <span class=\"text-sm text-stone-300 font-medium\" data-kid=\"91\">Add constraints or requirements...</span>\n           </div>\n           <button class=\"w-14 h-14 rounded-2xl bg-[#1A120B] text-white flex items-center justify-center hover:bg-stone-800 transition-all shadow-lg hover:shadow-xl active:scale-95\" data-kid=\"92\">\n              <i class=\"ti ti-arrow-up text-2xl\" data-kid=\"93\"></i>\n           </button>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute bottom-0 -left-12 rotate-[-3deg] z-30\" data-kid=\"94\">\n        <div class=\"flex items-center gap-4 bg-[#FBFBFA]/90 backdrop-blur-md p-3 px-5 rounded-2xl border border-stone-100 shadow-xl shadow-stone-200/40\" data-kid=\"95\">\n          <i class=\"ti ti-highlight text-cyan-600 text-4xl\" data-kid=\"96\"></i>\n          <span class=\"font-handwriting text-4xl text-[#1A120B] drop-shadow-sm whitespace-nowrap\" data-kid=\"97\">Contextually Aware</span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  \n  <style data-kid=\"98\">\n    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Inter:wght@400;500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-sans { font-family: 'Inter', sans-serif; }\n    .font-serif { font-family: 'Cormorant Garamond', serif; }\n    .font-handwriting { font-family: 'Caveat', cursive; }\n\n    .glass-card {\n      backdrop-filter: blur(20px) saturate(160%);\n      -webkit-backdrop-filter: blur(20px) saturate(160%);\n      background-color: rgba(255, 255, 255, 0.45);\n      border: 1px solid rgba(255, 255, 255, 0.5);\n      box-shadow: 0 15px 35px 0 rgba(0, 0, 0, 0.05),\n                  inset 0 0 0 1px rgba(255, 255, 255, 0.2);\n    }\n\n    .btn-aurora {\n      background: linear-gradient(90deg, #1c1917 0%, #3c2a21 25%, #1c1917 50%, #451a03 75%, #1c1917 100%);\n      background-size: 200% auto;\n      animation: aurora-move 6s linear infinite;\n    }\n\n    @keyframes aurora-move {\n      to { background-position: 200% center; }\n    }\n\n    /* Floating Animations */\n    @keyframes floating {\n      0% { transform: translate(0, 0) rotate(var(--rot)); }\n      50% { transform: translate(0, -15px) rotate(var(--rot)); }\n      100% { transform: translate(0, 0) rotate(var(--rot)); }\n    }\n\n    .floating-1 { --rot: -12deg; animation: floating 6s ease-in-out infinite; }\n    .floating-2 { --rot: 6deg; animation: floating 8s ease-in-out infinite 1s; }\n    .floating-3 { --rot: 0deg; animation: floating 7s ease-in-out infinite 0.5s; }\n\n    .perspective-1000 {\n      perspective: 1000px;\n    }\n  </style>\n</div>\n",
