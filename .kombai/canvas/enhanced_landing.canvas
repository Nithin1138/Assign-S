      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Inter:wght@300;400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --font-serif: \"Cormorant Garamond\", serif;\n    --font-sans: \"Inter\", sans-serif;\n    --bg-alabaster: #FBFBFA;\n    --accent-violet: #7C3AED;\n    --accent-cyan: #06B6D4;\n    --stone-50: #FBFBFA;\n    --stone-100: #F5F5F4;\n    --stone-200: #E7E5E4;\n    --stone-400: #A8A29E;\n    --stone-600: #57534E;\n    --stone-900: #1C1917;\n  }\n\n  body {\n    background-color: var(--bg-alabaster);\n    color: var(--stone-900);\n    margin: 0;\n    font-family: var(--font-sans);\n  }\n\n  .font-serif { font-family: var(--font-serif); }\n  .font-sans { font-family: var(--font-sans); }\n\n  /* Grid Background */\n  .architectural-grid {\n    background-image: \n      linear-gradient(to right, rgba(124, 58, 237, 0.05) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(124, 58, 237, 0.05) 1px, transparent 1px);\n    background-size: 64px 64px;\n  }\n\n  .paper-texture {\n    opacity: 0.03;\n    background-image: url(\"https://www.transparenttextures.com/patterns/natural-paper.png\");\n  }\n\n  /* Animations */\n  @keyframes fadeInUp {\n    from {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0) rotate(0deg); }\n    50% { transform: translateY(-20px) rotate(5deg); }\n  }\n\n  @keyframes pulse-slow {\n    0%, 100% { opacity: 0.3; transform: scale(1); }\n    50% { opacity: 0.6; transform: scale(1.1); }\n  }\n\n  @keyframes aurora-move {\n    0% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n    100% { background-position: 0% 50%; }\n  }\n\n  .animate-fade-in-up {\n    animation: fadeInUp 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;\n    opacity: 0;\n  }\n\n  .delay-100 { animation-delay: 100ms; }\n  .delay-200 { animation-delay: 200ms; }\n  .delay-300 { animation-delay: 300ms; }\n  .delay-500 { animation-delay: 500ms; }\n\n  .float-slow {\n    animation: float 8s ease-in-out infinite;\n  }\n\n  .float-slower {\n    animation: float 12s ease-in-out infinite;\n  }\n\n  /* Glass Card Overrides for Premium Feel */\n  .glass-card-hero {\n    backdrop-filter: blur(32px) saturate(140%);\n    -webkit-backdrop-filter: blur(32px) saturate(140%);\n    background: rgba(255, 255, 255, 0.5);\n    border: 1px solid rgba(255, 255, 255, 0.8);\n    box-shadow: \n      0 32px 64px -16px rgba(28, 25, 23, 0.12),\n      0 0 0 1px rgba(28, 25, 23, 0.03),\n      inset 0 0 0 1px rgba(255, 255, 255, 0.4);\n  }\n\n  /* Button Aurora */\n  .btn-premium-aurora {\n    background: linear-gradient(-45deg, #7C3AED, #4F46E5, #06B6D4, #7C3AED);\n    background-size: 400% 400%;\n    animation: aurora-move 10s ease infinite;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .btn-premium-aurora:hover {\n    transform: scale(1.02);\n    box-shadow: 0 0 40px rgba(124, 58, 237, 0.3);\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, var(--accent-violet) 0%, var(--accent-cyan) 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  .gradient-text-reverse {\n    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-violet) 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  .shape-outline {\n    filter: drop-shadow(0 0 10px rgba(124, 58, 237, 0.1));\n  }\n\n  .blur-depth {\n    filter: blur(2px) opacity(0.2);\n  }\n\n  .badge-glow {\n    box-shadow: 0 0 15px rgba(124, 58, 237, 0.15);\n  }\n</style>\n\n<div class=\"relative w-full h-[880px] overflow-hidden bg-[var(--stone-50)] flex flex-col items-center justify-center pt-20\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 architectural-grid pointer-events-none\" data-kid=\"2\"></div>\n  <div class=\"absolute inset-0 paper-texture pointer-events-none\" data-kid=\"3\"></div>\n\n  \n  <div class=\"absolute top-0 left-1/4 w-[500px] h-[500px] bg-violet-100/30 rounded-full blur-[120px] pointer-events-none animate-pulse-slow\" data-kid=\"4\"></div>\n  <div class=\"absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-cyan-100/20 rounded-full blur-[140px] pointer-events-none animate-pulse-slow\" style=\"animation-delay: 2s\" data-kid=\"5\"></div>\n\n  \n  <div class=\"absolute top-[18%] left-[14%] float-slow pointer-events-none opacity-40\" data-kid=\"6\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/skoll/diamonds.svg\" class=\"w-24 h-24 shape-outline\" style=\"filter: invert(34%) sepia(87%) saturate(2371%) hue-rotate(253deg) brightness(96%) contrast(92%);\" alt=\"diamond\" data-kid=\"7\">\n  </div>\n  <div class=\"absolute bottom-[22%] left-[10%] float-slower pointer-events-none blur-depth\" data-kid=\"8\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/plain-circle.svg\" class=\"w-20 h-20 shape-outline\" style=\"filter: invert(34%) sepia(87%) saturate(2371%) hue-rotate(253deg) brightness(96%) contrast(92%);\" alt=\"circle\" data-kid=\"9\">\n  </div>\n  <div class=\"absolute top-[22%] right-[12%] float-slower pointer-events-none blur-depth\" style=\"animation-delay: 1s\" data-kid=\"10\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/skoll/diamonds.svg\" class=\"w-28 h-28 shape-outline\" style=\"filter: invert(58%) sepia(97%) saturate(3015%) hue-rotate(155deg) brightness(96%) contrast(92%);\" alt=\"diamond\" data-kid=\"11\">\n  </div>\n  <div class=\"absolute bottom-[28%] right-[18%] float-slow pointer-events-none blur-depth\" style=\"animation-delay: 2s\" data-kid=\"12\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/circle.svg\" class=\"w-16 h-16 shape-outline\" style=\"filter: invert(58%) sepia(97%) saturate(3015%) hue-rotate(155deg) brightness(96%) contrast(92%);\" alt=\"circle\" data-kid=\"13\">\n  </div>\n\n  \n  <div class=\"relative z-10 w-full max-w-6xl mx-auto px-6 flex flex-col items-center\" data-kid=\"14\">\n    \n    \n    <div class=\"animate-fade-in-up\" data-kid=\"15\">\n      <div class=\"inline-flex items-center gap-2 px-5 py-2 rounded-full border border-violet-200 bg-white/60 backdrop-blur-sm badge-glow mb-10\" data-kid=\"16\">\n        <span class=\"w-2 h-2 rounded-full bg-violet-600 animate-pulse\" data-kid=\"17\"></span>\n        <span class=\"text-[11px] font-bold tracking-[0.25em] uppercase text-stone-600 font-sans\" data-kid=\"18\">Academic Excellence Powered by AI</span>\n      </div>\n    </div>\n\n    \n    <h1 class=\"animate-fade-in-up delay-100 font-serif text-[clamp(2.5rem,7vw,6.5rem)] text-stone-900 leading-[1.05] tracking-tight text-center max-w-5xl mx-auto mb-10\" data-kid=\"19\">\n      Write with <span class=\"italic font-serif gradient-text\" data-kid=\"20\">precision.</span><br data-kid=\"21\">\n      Deliver with <span class=\"italic font-serif gradient-text-reverse\" data-kid=\"22\">confidence.</span>\n    </h1>\n\n    \n    <p class=\"animate-fade-in-up delay-200 text-center text-lg md:text-xl text-stone-500 font-sans font-normal max-w-2xl mx-auto leading-relaxed mb-16\" data-kid=\"23\">\n      The professional writing suite designed for elite scholars. Transform research into perfectly structured, academic-grade submissions in seconds.\n    </p>\n\n    \n    <div class=\"animate-fade-in-up delay-300 w-full max-w-3xl\" data-kid=\"24\">\n      <div class=\"glass-card-hero p-2.5 rounded-[28px] flex items-center group transition-all duration-500\" data-kid=\"25\">\n        <div class=\"flex-1 flex items-center px-6\" data-kid=\"26\">\n          <i class=\"ti ti-file-pencil text-stone-500 text-xl mr-4 group-focus-within:text-violet-600 transition-colors\" data-kid=\"27\"></i>\n          <input type=\"text\" placeholder=\"Paste your prompt, research brief, or thesis statement...\" class=\"w-full bg-transparent border-none outline-none py-4 text-stone-900 placeholder-stone-500 font-sans text-base tracking-wide\" data-kid=\"28\">\n        </div>\n        <button class=\"btn-premium-aurora h-[60px] px-10 rounded-[20px] text-white font-bold tracking-[0.1em] text-sm flex items-center gap-3 shadow-xl\" data-kid=\"29\">\n          GENERATE\n          <i class=\"ti ti-sparkles text-lg\" data-kid=\"30\"></i>\n        </button>\n      </div>\n      \n      \n      <div class=\"flex items-center justify-center gap-12 mt-8 text-[10px] font-bold tracking-[0.15em] text-stone-500 uppercase\" data-kid=\"31\">\n        <div class=\"flex items-center gap-2.5 group cursor-help hover:text-stone-700 transition-colors\" data-kid=\"32\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-stone-400 group-hover:text-violet-600 transition-colors\" data-kid=\"33\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\" data-kid=\"34\"></path><polyline points=\"14 2 14 8 20 8\" data-kid=\"35\"></polyline><circle cx=\"10\" cy=\"15\" r=\"3\" data-kid=\"36\"></circle><line x1=\"12\" y1=\"17\" x2=\"15\" y2=\"20\" data-kid=\"37\"></line></svg>\n          Analyze Template\n        </div>\n        <div class=\"flex items-center gap-2.5 group cursor-help hover:text-stone-700 transition-colors\" data-kid=\"38\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-stone-400 group-hover:text-violet-600 transition-colors\" data-kid=\"39\"><path d=\"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z\" data-kid=\"40\"></path><line x1=\"9\" y1=\"10\" x2=\"15\" y2=\"10\" data-kid=\"41\"></line><line x1=\"9\" y1=\"14\" x2=\"13\" y2=\"14\" data-kid=\"42\"></line></svg>\n          Smart Citations\n        </div>\n        <div class=\"flex items-center gap-2.5 group cursor-help hover:text-stone-700 transition-colors\" data-kid=\"43\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-stone-400 group-hover:text-violet-600 transition-colors\" data-kid=\"44\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" data-kid=\"45\"></path><path d=\"m9 12 2 2 4-4\" data-kid=\"46\"></path></svg>\n          Academic Integrity\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"animate-fade-in-up delay-500 mt-24 w-full max-w-5xl pt-12 border-t border-stone-200/50\" data-kid=\"47\">\n      <p class=\"text-center text-[10px] font-bold text-stone-400 uppercase tracking-[0.4em] mb-12\" data-kid=\"48\">Trusted by scholars from global institutions</p>\n      <div class=\"flex flex-wrap items-center justify-between px-12 gap-x-12 gap-y-10 opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-1000\" data-kid=\"49\">\n        <div class=\"flex items-center gap-3 font-serif italic text-3xl text-stone-800 hover:text-violet-800 transition-all\" data-kid=\"50\">\n          <span class=\"font-black tracking-tighter\" data-kid=\"51\">IIT</span>\n        </div>\n        <div class=\"flex items-center gap-3 font-serif text-3xl text-stone-800 hover:text-violet-800 transition-all\" data-kid=\"52\">\n          <span class=\"font-light tracking-[0.3em] text-xl\" data-kid=\"53\">OXFORD</span>\n        </div>\n        <div class=\"flex items-center gap-3 font-serif italic text-3xl text-stone-800 hover:text-violet-800 transition-all\" data-kid=\"54\">\n          <span class=\"font-bold tracking-tight\" data-kid=\"55\">Stanford</span>\n        </div>\n        <div class=\"flex items-center gap-3 font-sans font-black text-3xl text-stone-800 hover:text-violet-800 transition-all\" data-kid=\"56\">\n          <span class=\"tracking-[-0.05em] text-4xl\" data-kid=\"57\">MIT</span>\n        </div>\n        <div class=\"flex items-center gap-3 font-serif italic text-3xl text-stone-800 hover:text-violet-800 transition-all\" data-kid=\"58\">\n          <span class=\"font-bold\" data-kid=\"59\">VIT</span>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  \n  <div class=\"absolute top-12 left-12 w-6 h-6 border-t border-l border-stone-300 pointer-events-none\" data-kid=\"60\"></div>\n  <div class=\"absolute top-12 right-12 w-6 h-6 border-t border-r border-stone-300 pointer-events-none\" data-kid=\"61\"></div>\n  <div class=\"absolute bottom-12 left-12 w-6 h-6 border-b border-l border-stone-300 pointer-events-none\" data-kid=\"62\"></div>\n  <div class=\"absolute bottom-12 right-12 w-6 h-6 border-b border-r border-stone-300 pointer-events-none\" data-kid=\"63\"></div>\n\n  \n  <div class=\"absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce opacity-50 hover:opacity-100 transition-opacity cursor-pointer z-20\" data-kid=\"64\">\n    <span class=\"text-[9px] font-bold tracking-[0.6em] text-stone-400 uppercase\" data-kid=\"65\">Explore</span>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-stone-400\" data-kid=\"66\"><path d=\"m6 9 6 6 6-6\" data-kid=\"67\"></path></svg>\n  </div>\n</div>\n",
